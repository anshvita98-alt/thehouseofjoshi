{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/index.js": {
            "includeFiles": "dist/server/**"
        }
    },
    "rewrites": [
        {
            "source": "/assets/:path*",
            "destination": "/assets/:path*"
        },
        {
            "source": "/:path*",
            "destination": "/api/index"
        }
    ]
}
